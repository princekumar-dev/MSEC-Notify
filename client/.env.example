# Client Environment Configuration
# For local development with Vite proxy, you can leave these empty:
VITE_API_URL=
VITE_SOCKET_URL=

# For production deployment (e.g., frontend on Vercel connecting to Render backend):
# VITE_API_URL=https://your-render-backend-url.onrender.com
# VITE_SOCKET_URL=https://your-render-backend-url.onrender.com
